# ══════════════════════════════════════════════════════════════
#  Damora AI — Environment Variables
#  Copy this file to .env and fill in the values.
#  Never commit .env to Git.
# ══════════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Production: add your Vercel URL here.
# Example: http://localhost:3000,https://damora-ai.vercel.app
FRONTEND_URL=http://localhost:3000

# ══════════════════════════════════════════════════════════════
#  DATABASE — Neon (production) / local PostgreSQL (dev)
# ══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://damora:damora@localhost:5432/damora
# Production (Neon): postgresql://[user]:[password]@[host]/neondb?sslmode=require

# ══════════════════════════════════════════════════════════════
#  JWT — Auth Tokens
# ══════════════════════════════════════════════════════════════
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ══════════════════════════════════════════════════════════════
#  ENCRYPTION — AES-256 for BYOK key storage
# ══════════════════════════════════════════════════════════════
# Must be exactly 32 characters in production.
ENCRYPTION_KEY=change-this-32-char-key-in-prod!

# ══════════════════════════════════════════════════════════════
#  AI PROVIDERS
# ══════════════════════════════════════════════════════════════
# Options: mock | gemini | openai | claude
AI_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# Gemini (Google AI Studio — free tier)
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# ══════════════════════════════════════════════════════════════
#  STORAGE — Cloudflare R2 (production) / MinIO (local dev)
# ══════════════════════════════════════════════════════════════
# Local MinIO:
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=damora
STORAGE_SECRET_KEY=damora123
STORAGE_BUCKET=damora-docs
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1

# Production (Cloudflare R2):
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=<R2 Access Key ID>
# STORAGE_SECRET_KEY=<R2 Secret Access Key>
# STORAGE_BUCKET=damora-docs
# STORAGE_USE_SSL=true
# STORAGE_REGION=auto

# ══════════════════════════════════════════════════════════════
#  REDIS — Upstash (production) / local Redis (dev)
# ══════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379
# Production (Upstash): rediss://default:<password>@<host>:<port>

# ══════════════════════════════════════════════════════════════
#  QDRANT — Qdrant Cloud (production) / local Qdrant (dev)
# ══════════════════════════════════════════════════════════════
QDRANT_URL=http://localhost:6333
# Production (Qdrant Cloud): https://xxxx-xxxx.aws.qdrant.io:6333
QDRANT_API_KEY=
# Leave empty for local dev. Required for Qdrant Cloud.
